{
  "expo": {
    "name": "ProfileCard",
    "slug": "profile-card-app-juan",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#6366F1"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mahasiswa.profilecard",
      "infoPlist": {
        "NSCameraUsageDescription": "ProfileCard membutuhkan akses kamera untuk mengambil foto profil.",
        "NSLocationWhenInUseUsageDescription": "ProfileCard membutuhkan akses lokasi untuk menampilkan koordinat kamu."
      }
    },
    "android": {
      "package": "com.mahasiswa.profilecard",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#6366F1"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "cameraPermission": "ProfileCard membutuhkan akses kamera untuk mengambil foto profil."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "ProfileCard membutuhkan akses lokasi untuk menampilkan koordinat kamu."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "631f0b5e-1899-45fe-95e2-b93ff838c88a"
      }
    },
    "owner": "juantambunan"
  }
}
